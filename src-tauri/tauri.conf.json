{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeManager",
  "version": "0.1.5",
  "identifier": "com.claudeconfigmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude 配置管理器",
        "width": 1024,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sql"
        ],
        "name": "Claude Config SQL Dump",
        "description": "cc-switch 备份的 provider .sql 文件",
        "role": "Editor",
        "mimeType": "application/sql"
      }
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "ClaudeConfigManager.entitlements"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4Q0I3RjAwREFDRDFFODEKUldTQkhzM2FBSC9MeVBJRU9Yam53cXpEUE1UVGN0RFE5Y0R6SnZidkpWYlhiRzkvUXR4ZVU2VisK",
      "endpoints": [
        "https://github.com/loonghao/claude-config-manager/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ccswitch"
        ]
      }
    }
  }
}