# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# F8 (M2.8) production installers — written by scripts/build-installer.sh.
# Separate from dist/ because tauri build runs `npm run build` which
# clears dist/ on every dev rebuild.
installers
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# M1.9.2 layout diagnostic artifacts (one-time debug screenshots)
.planning/diagnostics/

# Playwright test artifacts
test-results/

# local claude memory symlinks (project-irrelevant)
# .claude/skills/ is project-level tooling shared with the team (per CLAUDE.md),
# other .claude/ contents (settings / logs / providers / worktrees) stay local.
.claude/*
!.claude/settings.local.json
!.claude/skills/
# Python build artifacts inside skills — keep data + source, ignore __pycache__
.claude/skills/**/__pycache__/
*.pyc
updater-private.key
src/design-system/*.bak

# Subagent-Driven Development ledger (session scratch)
.superpowers/
